# NEVER commit this file to GitHub!
# Copy to .env and fill in your real values.

# Database
DB_PASSWORD=rubaih_secret_2026

# Delta Exchange API (USE TESTNET KEYS FIRST!)
# Get from: https://www.delta.exchange/app/settings/api
DELTA_API_KEY=your_delta_testnet_api_key
