# ============================================
# RUBAIH — Production Environment
# ============================================
# NEVER commit .env to GitHub.
# Copy to .env and fill real values before live trading.

# Database
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# CoinDCX LIVE API
# https://coindcx.com → Settings → API
# Restrict key permissions to futures trade only. IP-whitelist if available.
# Paste raw values only — no quotes, no spaces. Recreate engine after changes:
#   docker compose up -d --force-recreate rubaih_engine
COINDCX_API_KEY=
COINDCX_API_SECRET=

# MUST be "true" for real orders. Anything else = dry-run (no exchange orders).
LIVE_TRADING=false

# Shared secret for mobile ↔ API (kill switch, settings, dashboard)
# Generate: openssl rand -hex 32
RUBAIH_API_TOKEN=

# AI (optional) — Gemini primary, OpenRouter fallback
# Get Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override (default gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_API_KEY=

# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
